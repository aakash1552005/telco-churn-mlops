# Core Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Data Ingestion Settings
RAW_DATA_SOURCE_TYPE=url
RAW_DATA_LOCATION=https://raw.githubusercontent.com/IBM/telco-customer-churn-on-icp4d/master/data/Telco-Customer-Churn.csv
RAW_DATA_PATH=data/raw/telco_churn.csv

# API & Security Settings
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEYS=["dev-secret-key-12345"]
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=["http://localhost:3000"]

# MLflow Tracking & Registry
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_MODEL_NAME=telco-churn-classifier

# DVC Storage Remote
DVC_REMOTE_NAME=localremote
DVC_REMOTE_URL=.dvc/storage

# AWS & Container Registry
AWS_REGION=us-east-1
ECR_REPOSITORY_NAME=telco-churn-mlops

# Model Promotion Policy Thresholds (Master Contract Section 9)
PROMOTION_MIN_F1_DELTA=0.01
PROMOTION_MAX_PRECISION_DROP=0.02
PROMOTION_ALLOW_RECALL_DECREASE=False

# Drift & Retraining Policy Thresholds (Master Contract Section 10)
DRIFT_FEATURE_PSI_THRESHOLD=0.2
DRIFT_EVIDENTLY_SCORE_THRESHOLD=0.15
DRIFT_CONFIDENCE_THRESHOLD=0.75
DRIFT_CONSECUTIVE_WINDOWS=3
