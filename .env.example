# Core & Logging Settings
PROJECT_NAME=telco-churn-mlops
ENVIRONMENT=development
LOG_LEVEL=INFO

# API & Security Settings (Section 11)
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEYS=["dev-secret-key-123"]
RATE_LIMIT_PER_MINUTE=60/minute
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# MLflow Experiment & Registry Settings
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=telco-churn-prediction
MLFLOW_MODEL_NAME=telco-churn-model

# DVC Versioning Settings
DVC_REMOTE_NAME=local_remote
DVC_REMOTE_URL=data/dvc_remote

# AWS Cloud & ECR Settings
AWS_REGION=us-east-1
ECR_REPOSITORY_NAME=telco-churn-api

# Promotion Policy Thresholds (Master Contract Section 9)
PROMOTION_MIN_F1_DELTA=0.01
PROMOTION_MAX_PRECISION_DROP=0.02
PROMOTION_ALLOW_RECALL_DECREASE=False

# Drift & Retraining Policy Thresholds (Master Contract Section 10)
DRIFT_FEATURE_PSI_THRESHOLD=0.2
DRIFT_EVIDENTLY_SCORE_THRESHOLD=0.15
DRIFT_CONFIDENCE_THRESHOLD=0.75
DRIFT_CONSECUTIVE_WINDOWS=3
